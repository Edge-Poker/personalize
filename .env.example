# Copie para .env.local e preencha. .env.local nao vai para o git.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seuprojeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo. Ignora RLS por completo.
# So no servidor. Nunca com prefixo NEXT_PUBLIC_, nunca importado por
# componente de cliente. Se vazar, quem tiver a chave le todos os leads e
# todas as propostas.
SUPABASE_SERVICE_ROLE_KEY=

# Sem barra no fim. Em producao, o dominio de verdade.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A sua conta. E o e-mail que entra no painel e o que recebe aviso de lead.
ADMIN_EMAIL=

# resend.com > API Keys. Sem isso o site funciona, mas nao avisa de lead novo.
RESEND_API_KEY=
